 id="audit" value="&lt;div style=&quot;background:#b9691b;color:white;font-weight:bold;font-size:28px;padding:12px 14px&quot;&gt;RegistroAuditoria&lt;/div&gt;&lt;div style=&quot;padding:12px 14px;color:#263a53;font-family:Arial;font-size:21px;line-height:1.35;text-align:left&quot;&gt;+ Long id&lt;br/&gt;+ Long usuarioId&lt;br/&gt;+ Long pacienteId&lt;br/&gt;+ AcaoAuditoria acao&lt;br/&gt;+ LocalDateTime dataHora&lt;/div&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontSize=21;fontColor=#263a53;fillColor=#ffffff;strokeColor=#b8c8d8;strokeWidth=2;shadow=1;" parent="1" vertex="1"><mxGeometry x="1270" y="1990" width="1040" height="325" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;LEGENDA E INVARIANTES&lt;/b&gt;&lt;br/&gt;Linha contínua com losango = composição interna ao agregado; linha tracejada = referência por identificador.&lt;br/&gt;Atendimento é imutável (RN05); SolicitacaoDeExame é agregado independente e atualiza apenas status.&lt;br/&gt;SOLICITADO → REALIZADO / CANCELADO. Referências entre módulos por pacienteId, profissionalId e consultaId." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=23;fontColor=#334f6e;fontSize=23;fillColor=#ffffff;strokeColor=#bbc9da;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="65" y="2380" width="2865" height="185" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>